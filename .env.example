# ==============================================================================
# Environment Configuration Template for Trade-Bot
# Copy this file to .env and configure for your local environment.
# NEVER commit .env with real credentials to version control.
# ==============================================================================

# Application Environment (BACKTEST | PAPER | LIVE)
TRADE_BOT_ENV=BACKTEST

# Execution Mode (BACKTEST | PAPER | LIVE)
# LIVE mode requires explicitly setting TRADE_BOT_ALLOW_LIVE=true
TRADE_BOT_EXECUTION_MODE=BACKTEST
TRADE_BOT_ALLOW_LIVE=false

# Logging Configuration
TRADE_BOT_LOG_LEVEL=INFO
TRADE_BOT_LOG_FORMAT=JSON
TRADE_BOT_LOG_DIR=logs
TRADE_BOT_AUDIT_DIR=audit

# Upstox API Credentials (Required ONLY for LIVE and real-feed PAPER mode)
UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here
UPSTOX_REDIRECT_URI=https://127.0.0.1:5000/callback
UPSTOX_ACCESS_TOKEN=

# Risk Management Overrides (Optional environment overrides)
TRADE_BOT_MAX_DAILY_LOSS=5000.0
TRADE_BOT_MAX_POSITION_SIZE=100000.0
TRADE_BOT_MAX_OPEN_POSITIONS=3
TRADE_BOT_MAX_LOSS_PER_TRADE=1500.0
TRADE_BOT_CAPITAL=100000.0
